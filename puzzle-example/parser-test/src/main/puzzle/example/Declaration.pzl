fun log(args: String*) {
    println(args.joinToString())
}

trait Logger {

    fun log(args: String?+)
}

mixin LoggerMixin on Logger {

    override fun log(args: String+) {
        println($"[LoggerMixin]: ${args.joinToString()}")
    }
}

class Player : Logger with LoggerMixin {

    fun start() {
        println("Start")
    }
