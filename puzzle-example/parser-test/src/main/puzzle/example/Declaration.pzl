    val value8 = i++.name()
    val value9 = (++i).name()    // 语法错误
    val value10 = b ? c ?: (d + 1) * 10 : e ?: f
    val value11 = b.c in d && e.f() !in g.h[0]
    val value12 = getLambda()()
    value11.toString()
        .test1()
        .test2()
        .test3()
    name ?= "LJW"
    list[0] = 2
    val _ = notNeedReturnValue()
    val [var name: String, val _: String] = xxx()
    var [name2] = xxx()
    [val name3, var age3] = xxx()
    [val age4] = xxx()
    [_, val age5] = xxx()
}

