/**
 * 操作符测试
 */
fun operatorTest() {
    val num = 0
    val plus = 1 + 2
    val prefixPlus = ++num
    val suffixPlus = num++
    val minus = 1 - 2
    val prefixMinus = --num
    val suffixPlus = num--
    val star = 1 * 2
    val slash = 1 / 2
    val percent = 1 % 2
    val group = (++a * b-- / c % d ** e - f) +
        (g << h >> i >>> j) +
        (x + y - z)
    val and = true && false
    val or = true || false
    val third = true ? true ? 1 : 2 : 3
    var i = 0
    val result = ++i + i++ - ++i + i++
    val result2 = xx.yy && xx.zz
}

