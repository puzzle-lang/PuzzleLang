package puzzle.example.ast

error EmptyKeyError

error NotFoundError(
    val message: String
)

errors[EmptyKeyError | NotFoundError]
fun getNicknameByUsername(inputs: Map<String, String>, key: String): String {
    if (key.isEmpty()) return EmptyKeyError
    if (key !in inputs) return NotFoundError("$key is not found!")
    return inputs.first { it.key == key }
}

errors[NotFoundError]
fun test(): [Int, String] {
    return NotFoundError
}

fun test() {
    val map = mapOf(Pair("A", "a"), Pair("B", "b"))
    val nickname1 = getNicknameByUsername(map, "LJW") |: return
    val nickname2 = match (getNicknameByUsername(map, "LJW")) {
        is String as username -> username
        is EmptyKeyError -> {
            println("key is empty.")
            return
        }
        is NotFoundError as e -> {
            println(e.message)
            return
        }
    }
}